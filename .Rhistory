inherit.aes = FALSE
) +
facet_grid(
Confidence_Level ~ Portfolio
) +
labs(
title = "Backtesting Comparison of VaR Models Across Portfolios",
subtitle = "Dashed lines indicate theoretically expected exceedance rates",
x = "VaR Model",
y = "Actual Exceedance Rate (%)",

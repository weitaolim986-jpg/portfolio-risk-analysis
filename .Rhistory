spy_price = covid_spy,
ief_price = covid_ief,
gld_price = covid_gld,
period_name = "COVID-19 Sell-Off"
)
rate_asset_price_data <- create_stress_price_data(
spy_price = rate_spy,
ief_price = rate_ief,
gld_price = rate_gld,
period_name = "2022 Inflation / Rising-Rate Environment"
